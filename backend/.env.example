# Copy to .env and fill in real values. .env is gitignored (see root .gitignore).

DATABASE_URL=
DB_ECHO=false

# ── LLM / OpenRouter ─────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Must be a model that supports tool calling. Verify against OpenRouter's
# current model list before relying on this default.
LLM_MODEL=google/gemini-flash-1.5
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_AGENT_SECONDS=60

# ── Agent behaviour ──────────────────────────────────────────────────────
AGENT_RECURSION_LIMIT=12
AGENT_MAX_HISTORY_TURNS=10
QUERY_ROW_LIMIT=200

# ── App ───────────────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
